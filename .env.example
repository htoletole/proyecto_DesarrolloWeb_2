# Variables para Docker Compose: copia este archivo como .env (el .env nunca se sube al repo)
# Por defecto usa las bases de datos de los contenedores postgres y mongo

# PostgreSQL. Para usar Neon pega aqui tus conexiones:
# DATABASE_URL = conexion directa (migraciones), DATABASE_URL_POOLED = conexion con -pooler (la app)
DATABASE_URL=postgresql://syllab:syllab123@postgres:5432/syllab
DATABASE_URL_POOLED=postgresql://syllab:syllab123@postgres:5432/syllab

# MongoDB. Para usar Atlas pega aqui tu conexion mongodb+srv://...
MONGODB_URI=mongodb://mongo:27017/syllab

# Clave para firmar los tokens de sesion (pon una frase larga)
JWT_SECRET=cambia-esta-frase-por-una-larga

# Puertos y direcciones
PORT=3000
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000/api
