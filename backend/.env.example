# Copia este archivo como .env y cambia los valores (el .env nunca se sube al repo)

# PostgreSQL (Neon o local)
# DATABASE_URL: conexion directa, la usa Prisma para las migraciones
# DATABASE_URL_POOLED: conexion con pooler (-pooler en el host), la usa la app
# En local las dos pueden ser iguales
DATABASE_URL="postgresql://syllab:syllab123@localhost:5432/syllab"
DATABASE_URL_POOLED="postgresql://syllab:syllab123@localhost:5432/syllab"

# MongoDB (Atlas o local): historial de actividad y eventos de planificacion
MONGODB_URI="mongodb://localhost:27017/syllab"

# Clave para firmar los tokens de sesion (pon una frase larga)
JWT_SECRET="cambia-esta-frase-por-una-larga"

# Puerto del backend y direccion del frontend (para CORS)
PORT=3000
FRONTEND_URL="http://localhost:5173"
